## Create a function to calculate the amount of missing values, the mean, median, and standard deviation.

```{r, eval=TRUE, echo=TRUE, message=FALSE, warning=FALSE, class.source="fold-show", fig.height=5, fig.width=8, results='show', cache=FALSE}
#### Create the function #### 
stats_1 <- function(df) {
  #### check for numeric values in columns ####
  cols_num <- sapply(df, is.numeric)
  #### take only numeric columns ####
  df_num <- df[, cols_num]
  
  #### calculate the statistics of numeric columns ####
  stats_1a <- data.frame(
    column = names(df_num),
    missing_val = sapply(df_num, function(x) sum(is.na(x))),
    mean = sapply(df_num, function(x) mean(x, na.rm=TRUE)),
    median = sapply(df_num, function(x) median(x, na.rm=TRUE)),
    std_dev= sapply(df_num, function(x) sd(x, na.rm=TRUE))
  )
  return(stats_1a)
}

#### Execute the function ####
stats_num <- stats_1(iris_data)
print("Numeric Stats")
print(stats_num)
```

## Visualizing the numerical statistical results as box plots.

```{r numerical_stats, echo=FALSE}
#### Load the necessary libraries ####
library(ggplot2)
library(reshape2)

####Create function to make box plots####
num_boxplots <- function(df) {
  #### Identify numeric columns####
  num_cols <- sapply(df, is.numeric)
  df_num <- df[, num_cols, drop = FALSE]
  
  #### Reshape the data to a long format, instead of a wide format, for ggplot####
  df_long <- reshape2::melt(df_num)
  
  #### Create box plots for all numeric columns####
  ggplot(df_long, aes(x = variable, y = value)) +
    geom_boxplot() +
    theme_minimal() +
    labs(title = "Boxplots of Numeric Columns", x = "Columns", y = "Values") +
    ####Rotate x-axis labels####
    theme(axis.text.x = element_text(angle = 45, hjust = 1))  
}

####Execute the function####
num_boxplots(iris_data)
```

